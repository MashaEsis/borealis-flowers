<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>CoreAdmin</id>
    <version>4.0.0</version>
    <title>Core Admin Panel for ASP.NET Core</title>
    <authors>edandersen</authors>
    <license type="expression">LGPL-3.0-or-later</license>
    <licenseUrl>https://licenses.nuget.org/LGPL-3.0-or-later</licenseUrl>
    <projectUrl>https://github.com/edandersen/core-admin</projectUrl>
    <description>Automagically add an Admin Panel to your .NET 10 web app.</description>
    <copyright>Copyright ©2026 Ed Andersen</copyright>
    <repository type="git" commit="13380dfb1947e80328f731f8aca7977fedf4bd17" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Microsoft.EntityFrameworkCore" version="10.0.1" exclude="Build,Analyzers" />
        <dependency id="NonFactors.Grid.Core.Mvc6" version="8.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkReferences>
      <group targetFramework="net10.0">
        <frameworkReference name="Microsoft.AspNetCore.App" />
      </group>
    </frameworkReferences>
  </metadata>
</package>