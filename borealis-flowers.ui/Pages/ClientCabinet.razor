@page "/cabinet/client"
@inject AppSessionService Session

<section class="card-panel">
    <h1 style="margin-top:0;">Мои заказы</h1>
    <p class="muted-small">Текущие заказы и архив выполненных.</p>

    @if (!Session.IsClient)
    {
        <div class="notice-banner">
            <NavLink class="link-accent" href="/login">Войдите</NavLink> как клиент.
        </div>
    }
    else
    {
        <ProfileOrdersSection/>
    }
</section>

