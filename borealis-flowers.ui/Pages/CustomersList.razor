@page "/cabinet/customers"
@inject BackendApiClient Api
@inject AppSessionService Session

<section class="card-panel">
    <h1 style="margin-top:0;">Клиенты</h1>
    <p class="muted-small">Список клиентов студии (без флористов и администраторов).</p>

    @if (!Session.IsFlorist && !Session.IsAdmin)
    {
        <div class="notice-banner">Раздел для флористов.</div>
    }
    else if (_rows is null)
    {
        <p class="muted-small">Загрузка…</p>
    }
    else if (_rows.Count == 0)
    {
        <p class="muted-small">Клиентов пока нет.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
            <tr>
                <th>Имя</th>
                <th>Email</th>
                <th>Телефон</th>
            </tr>
            </thead>
            <tbody>
            @foreach (CustomerBriefDto c in _rows)
            {
                <tr>
                    <td>@c.Name</td>
                    <td>@(c.Email ?? "—")</td>
                    <td>@(c.Phone ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

@code {

    List<CustomerBriefDto>? _rows;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsFlorist && !Session.IsAdmin)
            return;

        try
        {
            _rows = await Api.Http.GetFromJsonAsync<List<CustomerBriefDto>>("staff/customers");
        }
        catch
        {
            _rows = [];
        }
    }

}
