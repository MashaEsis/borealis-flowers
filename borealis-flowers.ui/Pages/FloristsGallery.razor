@page "/florists"

@inject FloristCatalogService FloristCatalogService

<section class="card-panel">
    <h1 style="margin-top:0;">Мастера Borealis</h1>

    <p class="muted-small">
        Свяжите визит с портфолио каждого — вы увидите демонстрационные локальные снимки, пока живой галереей не управляет ваш API медиафайлов.
    </p>
</section>

<div class="fl-grid" style="margin-top:1.5rem;">
    @foreach (FloristVm florist in FloristCatalogService.Cached)
    {
        <article class="card-panel">
            <img loading="lazy" class="fl-photo" src="@florist.ImgUrl" alt="@($"Портрет {florist.FullName}")"/>

            <h2 style="margin:.75rem 0 .25rem;font-size:1.2rem;">
                @florist.FullName
            </h2>

            <p class="muted-small" style="margin:0;line-height:1.4;">
                @(string.IsNullOrWhiteSpace(florist.City) ? "Студийный флорист" : florist.City) · @(string.IsNullOrWhiteSpace(florist.Specialization) ? "Студийные композиции" :
                florist.Specialization)
            </p>

            <div style="margin-top:1rem;">
                <NavLink class="btn btn-soft" href="@($"/florists/{florist.Id}/portfolio")" style="text-decoration:none;display:inline-flex;align-items:center;">Просмотреть портфолио</NavLink>
            </div>
        </article>
    }

    @if (FloristCatalogService.Cached.Count == 0)
    {
        <p class="card-panel muted-small">Не удалось подгрузить список. Проверьте `BackendApiUrl` или включите офлайновый режим после перезапуска.</p>
    }
</div>
