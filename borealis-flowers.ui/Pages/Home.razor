@page "/"
@inject BackendApiClient Api
@inject AppSessionService Session
@using borealis_flowers.ui.Helpers

<section class="home-hero">
    <div class="home-hero-copy">
        <p class="status-pill">Borealis Flowers · @StudioConstants.City</p>
        <h1 class="home-hero-title">Свежие букеты и декор для ваших событий</h1>
        <p class="muted-small home-hero-lead">
            Студия в Гомеле: доставка по городу, сезонные цветы и понятные сроки.
        </p>
        <div class="home-hero-actions">
            <NavLink class="btn btn-primary" href="/services">Каталог букетов</NavLink>
            @if (Session.IsClient)
            {
                <NavLink class="btn btn-soft" href="/profile">Счёт и профиль</NavLink>
                <NavLink class="btn btn-ghost" href="/cabinet/client">Мои заказы</NavLink>
            }
            else if (Session.IsVisitor)
            {
                <NavLink class="btn btn-ghost" href="/login">Войти</NavLink>
            }
        </div>
    </div>
    <div class="home-hero-visual">
        <img src="https://images.unsplash.com/photo-1490759847152-847979872120?w=900&auto=format&fit=crop&q=80"
             alt="Букет Borealis Flowers" loading="eager"/>
    </div>
</section>

@if (_highlights is not null)
{
    <section class="home-spotlight">
        @if (_highlights.PopularBouquet is PopularBouquetHighlightDto bouquet)
        {
            <article class="spotlight-card">
                <p class="spotlight-kicker">Популярный букет месяца</p>
                @{
                    string img = string.IsNullOrWhiteSpace(bouquet.ImageUrl)
                        ? $"https://picsum.photos/seed/bouquet-{bouquet.Id:N}/640/480"
                        : bouquet.ImageUrl;
                }
                <img src="@img" alt="@bouquet.Name" class="spotlight-photo" loading="lazy"/>
                <h2>@bouquet.Name</h2>
                <p class="muted-small">@bouquet.Price.ToString("N0") ₽ · @_orderLabel(bouquet.OrderCount)</p>
                <NavLink class="btn btn-primary" href="@($"/services/{bouquet.Id:D}")">Заказать</NavLink>
            </article>
        }

        @if (_highlights.TopFlorist is TopFloristHighlightDto florist)
        {
            <article class="spotlight-card">
                <p class="spotlight-kicker">Флорист месяца</p>
                <img src="@florist.ImgUrl" alt="@florist.FullName" class="spotlight-photo portrait" loading="lazy"/>
                <h2>@florist.FullName</h2>
                <p class="muted-small">@florist.CompletedOrders @CompletedWord(florist.CompletedOrders) в этом месяце</p>
                <NavLink class="btn btn-ghost" href="@($"/florists/{florist.Id:D}/portfolio")">Портфолио</NavLink>
            </article>
        }
    </section>
}

<section class="home-quick card-panel">
    <h2 style="margin-top:0;font-size:1.05rem;">Быстрые ссылки</h2>
    <div class="home-quick-grid">
        <NavLink class="home-quick-item" href="/services">
            <strong>Каталог</strong>
            <span class="muted-small">Букеты на заказ</span>
        </NavLink>
        <NavLink class="home-quick-item" href="/events">
            <strong>Мероприятия</strong>
            <span class="muted-small">Свадьбы и праздники</span>
        </NavLink>
        <NavLink class="home-quick-item" href="/florists">
            <strong>Флористы</strong>
            <span class="muted-small">Команда студии</span>
        </NavLink>
        @if (Session.IsClient)
        {
            <NavLink class="home-quick-item" href="/profile">
                <strong>Счёт</strong>
                <span class="muted-small">Баланс и карты</span>
            </NavLink>
        }
    </div>
</section>

<section class="card-panel home-about">
    <div class="two-column">
        <div>
            <h2 style="margin-top:0;">О студии</h2>
            <p class="muted-small" style="line-height:1.55;">
                Собираем букеты под настроение, оформляем свадьбы и корпоративы.
                Спокойная палитра, аккуратная логистика и доставка по @StudioConstants.CityRegion.
            </p>
        </div>
        <div>
            <h3 style="margin-top:0;font-size:.95rem;">Контакты</h3>
            <p class="muted-small" style="margin:0;">
                <a href="mailto:@StudioConstants.ContactEmail" class="link-accent">@StudioConstants.ContactEmail</a><br/>
                <a href="tel:@StudioConstants.ContactPhone.Replace(" ", "")" class="link-accent">@StudioConstants.ContactPhone</a>
            </p>
        </div>
    </div>
</section>

@code {

    HomeHighlightsDto? _highlights;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _highlights = await Api.Http.GetFromJsonAsync<HomeHighlightsDto>("home/highlights");
        }
        catch
        {
            _highlights = null;
        }
    }

    static string _orderLabel(int count) =>
        count switch
        {
            0 => "новинка сезона",
            1 => "1 заказ в этом месяце",
            _ => $"{count} заказов в этом месяце",
        };

    static string CompletedWord(int n)
    {
        int m = Math.Abs(n) % 100;
        int n1 = m % 10;
        if (m is > 10 and < 20) return "заказов";
        return n1 switch { 1 => "заказ", 2 or 3 or 4 => "заказа", _ => "заказов" };
    }

}
