@page "/"

<section class="card-panel">
    <p class="status-pill">Студия Borealis Flowers · Казань</p>
    <h1 class="tagline-heading" style="margin-top:.75rem;">
        Нежные композиции и декор без визуального шума
    </h1>
    <p class="muted-small" style="max-width:60ch;">
        Мы создаём букеты, оформляем свадьбы и корпоративы, проводим мастер-классы.
        В основе — спокойная палитра, аккуратная геометрия и уважение к сезону цветов.
    </p>
</section>

<section class="card-panel">
    <h2 style="margin-top:0;">Ценности</h2>
    <div class="two-column">
        <div>
            <h3 style="margin-top:0;">Сдержанная эстетика</h3>
            <p class="muted-small">Без перегруза текстурами: воздух между ветками и чистая линия.</p>
        </div>
        <div>
            <h3 style="margin-top:0;">Ответственность</h3>
            <p class="muted-small">Понятные сроки, прозрачное общение и аккуратная логистика.</p>
        </div>
    </div>
</section>

<section class="card-panel">
    <h2 style="margin-top:0;">Что делаем</h2>
    <div class="home-services">
        <div class="mini-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 21s7-5 7-10a7 7 0 10-14 0c0 5 7 10 7 10z"/>
                <circle cx="12" cy="11" r="2.5"/>
            </svg>
            <div>
                <strong>Букеты на заказ</strong>
                <p class="muted-small" style="margin:.35rem 0 0;">Собираем под настроение и сезон.</p>
            </div>
        </div>
        <div class="mini-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M4 20h16"/>
                <path d="M8 16l2-6 3 4 3-8 2 10"/>
            </svg>
            <div>
                <strong>Свадебная флористика</strong>
                <p class="muted-small" style="margin:.35rem 0 0;">Арки, букеты, настольные композиции.</p>
            </div>
        </div>
        <div class="mini-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="5" width="18" height="14" rx="2"/>
                <path d="M7 15h4M7 11h10"/>
            </svg>
            <div>
                <strong>Корпоративы</strong>
                <p class="muted-small" style="margin:.35rem 0 0;">Декор премий, запусков и выставок.</p>
            </div>
        </div>
        <div class="mini-card">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 2"/>
            </svg>
            <div>
                <strong>Мастер-классы</strong>
                <p class="muted-small" style="margin:.35rem 0 0;">Спокойный формат без спешки.</p>
            </div>
        </div>
    </div>
    <div style="margin-top:1.25rem;display:flex;flex-wrap:wrap;gap:.65rem;">
        <NavLink class="btn btn-primary" href="/services" style="text-decoration:none;">Заказать букет</NavLink>
        <NavLink class="btn btn-ghost" href="/services" style="text-decoration:none;">Перейти к услугам</NavLink>
    </div>
</section>

<section class="card-panel">
    <h2 style="margin-top:0;">Настроение</h2>
    <p class="muted-small">Случайные кадры с Unsplash по тегу «flowers» — для живого ощущения студии.</p>
    <div class="hero-grid">
        @foreach (string url in _unsplash)
        {
            <div class="hero-tile">
                <img src="@url" width="640" height="480" loading="lazy"
                     alt="Цветочная композиция"/>
            </div>
        }
    </div>
</section>

<section class="card-panel">
    <h2 style="margin-top:0;">Контакты</h2>
    <p>
        <a href="mailto:hello@borealis-flowers.example" class="link-accent">hello@borealis-flowers.example</a>
        · <a href="tel:+79990000000" class="link-accent">+7 999 000-00-00</a>
    </p>
    <p class="muted-small">
        Соцсети:
        <a class="link-accent" href="https://t.me/" target="_blank" rel="noreferrer">Telegram</a>,
        <a class="link-accent" href="https://vk.com/" target="_blank" rel="noreferrer">VK</a>
    </p>
</section>

@code {

    readonly string[] _unsplash =
    [
        "https://source.unsplash.com/featured/640/480/?flowers&sig=1",
        "https://source.unsplash.com/featured/640/480/?bouquet&sig=2",
        "https://source.unsplash.com/featured/640/480/?peony&sig=3",
    ];

}
