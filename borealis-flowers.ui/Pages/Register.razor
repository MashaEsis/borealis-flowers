@page "/register"
@layout AuthLayout

@inject BackendApiClient Api
@inject AppSessionService Session
@inject BrowserStorageService Browser
@inject NavigationManager Nav

<section class="auth-card">
    <h1 style="margin-top:0;">Регистрация</h1>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="notice-banner">@_error</div>
    }

    <div class="field">
        <label>Имя</label>
        <input @bind="_name" maxlength="120" autocomplete="name"/>
    </div>
    <div class="field">
        <label>Email</label>
        <input type="email" @bind="_email" autocomplete="email"/>
    </div>
    <div class="field">
        <label>Телефон (необязательно)</label>
        <input @bind="_phone" type="tel" autocomplete="tel"/>
    </div>
    <div class="field">
        <label>Пароль</label>
        <input type="password" class="form-input" @bind="_password" autocomplete="new-password"/>
    </div>

    <button class="btn btn-primary" type="button" disabled="@_busy" @onclick="SubmitAsync">
        @(_busy ? "Создаём…" : "Создать аккаунт")
    </button>

    <p class="muted-small" style="margin-top:1.25rem;">
        Уже есть аккаунт?
        <NavLink class="link-accent" href="/login">Войти</NavLink>
    </p>
</section>

@code {

    string _name = "";

    string _email = "";

    string _phone = "";

    string _password = "";

    string? _error;

    bool _busy;

    async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            HttpResponseMessage res = await Api.Http.PostAsJsonAsync(
                "auth/register",
                new RegisterRequestDto
                {
                    Name = _name.Trim(),
                    Email = _email.Trim(),
                    Password = _password,
                    Phone = string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
                });

            if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _error = "Пользователь с таким email уже зарегистрирован.";
                return;
            }

            if (!res.IsSuccessStatusCode)
            {
                _error = "Не удалось зарегистрироваться. Проверьте поля.";
                return;
            }

            AuthResponseDto? body = await res.Content.ReadFromJsonAsync<AuthResponseDto>();
            if (body is null)
            {
                _error = "Пустой ответ сервера.";
                return;
            }

            await Session.ApplyAuthAsync(body, Browser);
            Nav.NavigateTo("/");
        }
        catch
        {
            _error = "Не удалось связаться с API (порт 5298).";
        }
        finally
        {
            _busy = false;
        }
    }

}
