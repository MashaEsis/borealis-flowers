@page "/profile"
@inject BackendApiClient Api
@inject AppSessionService Session
@inject BrowserStorageService Browser
@using borealis_flowers.ui.Helpers

<section class="card-panel profile-compact">
    @if (Session.IsVisitor)
    {
        <div class="notice-banner">
            <NavLink class="link-accent" href="/login">Войдите</NavLink>, чтобы открыть профиль.
        </div>
    }
    else if (_error is not null && _profile is null)
    {
        <div class="notice-banner">@_error</div>
    }
    else if (_profile is null)
    {
        <p class="muted-small">Загрузка…</p>
    }
    else
    {
        <div class="profile-top">
            <div>
                <h1 style="margin:0;font-size:1.2rem;">@_name</h1>
                <p class="muted-small" style="margin:.25rem 0 0;">@DescribeRole(Session.Role)</p>
            </div>
            @if (_saved)
            {
                <span class="status-pill status-done">Сохранено</span>
            }
        </div>

        @if (_error is not null)
        {
            <div class="notice-banner" style="margin-top:.75rem;">@_error</div>
        }

        <div class="profile-fields">
            <div class="field">
                <label>Email</label>
                <input type="email" @bind="_email"/>
            </div>
            <div class="field">
                <label>Телефон</label>
                <input type="tel" @bind="_phone" placeholder="@StudioConstants.PhoneExample"/>
            </div>
            <div class="field">
                <label>Имя</label>
                <input type="text" @bind="_name"/>
            </div>
            <div class="field">
                <label>День рождения</label>
                <input type="date" @bind="_birthday" class="form-input"/>
            </div>
        </div>

        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveAsync">
            @(_busy ? "…" : "Сохранить")
        </button>
    }
</section>

@if (Session.IsClient && _profile is not null)
{
    <WalletSection @ref="_wallet"/>
}

@if (!Session.IsVisitor && !Session.IsClient)
{
    <section class="card-panel">
        <div class="profile-links">
            @if (Session.IsFlorist || Session.IsAdmin)
            {
                <NavLink class="profile-link-card" href="/cabinet/florist">
                    <strong>Рабочий стол</strong>
                    <span class="muted-small">Заказы букетов</span>
                </NavLink>
                <NavLink class="profile-link-card" href="/cabinet/florist/portfolio">
                    <strong>Портфолио</strong>
                </NavLink>
            }
            <NavLink class="profile-link-card" href="/florists">
                <strong>Флористы</strong>
            </NavLink>
        </div>
    </section>
}

@code {

    UserMeDto? _profile;

    WalletSection? _wallet;

    string _name = "";

    string _email = "";

    string _phone = "";

    DateTime? _birthday;

    string? _error;

    bool _busy;

    bool _saved;

    protected override async Task OnInitializedAsync()
    {
        if (Session.IsVisitor)
            return;

        await LoadAsync();
    }

    async Task LoadAsync()
    {
        _error = null;
        _saved = false;
        try
        {
            _profile = await Api.Http.GetFromJsonAsync<UserMeDto>("auth/me");
            if (_profile is null)
            {
                _error = "Не удалось загрузить профиль.";
                return;
            }

            _name = _profile.Name;
            _email = _profile.Email ?? "";
            _phone = _profile.Phone ?? "";
            _birthday = _profile.Birthday;
        }
        catch
        {
            _error = "Не удалось загрузить профиль.";
        }
    }

    async Task SaveAsync()
    {
        _error = null;
        _saved = false;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _error = "Укажите имя.";
            return;
        }

        _busy = true;
        try
        {
            HttpResponseMessage res = await Api.Http.PutAsJsonAsync(
                "auth/profile",
                new UpdateProfileRequestDto
                {
                    Name = _name.Trim(),
                    Email = string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                    Phone = string.IsNullOrWhiteSpace(_phone) ? null : _phone.Trim(),
                    Birthday = _birthday,
                });

            if (res.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _error = "Email уже занят.";
                return;
            }

            if (!res.IsSuccessStatusCode)
            {
                _error = "Не удалось сохранить.";
                return;
            }

            UserMeDto? updated = await res.Content.ReadFromJsonAsync<UserMeDto>();
            if (updated is not null)
            {
                _profile = updated;
                await Session.ApplyProfileAsync(updated, Browser);
            }

            _saved = true;
        }
        catch
        {
            _error = "Ошибка сети.";
        }
        finally
        {
            _busy = false;
        }
    }

    static string DescribeRole(StudioRole role) =>
        role switch
        {
            StudioRole.Client => "клиент",
            StudioRole.Florist => "флорист",
            StudioRole.Admin => "администратор",
            _ => "гость",
        };

}
